<?xml version="1.0" encoding="UTF-8"?>
<!--
    top level element of the Spring configuration. Note the multiple namespace definition for both
    GigaSpaces and Spring. You can simply copy and paste this portion of the pu.xml file

-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:os-core="http://www.openspaces.org/schema/core"
       xmlns:os-events="http://www.openspaces.org/schema/events"
       xmlns:os-remoting="http://www.openspaces.org/schema/remoting"
       xmlns:aop="http://www.springframework.org/schema/aop"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd
        http://www.openspaces.org/schema/core http://www.openspaces.org/schema/core/openspaces-core.xsd
        http://www.openspaces.org/schema/events http://www.openspaces.org/schema/events/openspaces-events.xsd
        http://www.openspaces.org/schema/remoting http://www.openspaces.org/schema/remoting/openspaces-remoting.xsd
        http://www.springframework.org/schema/aop http://www.springframework.org/schema/aop/spring-aop.xsd">


    <bean id="clientReadProfiler" class="com.gigaspaces.demo.aop.ClientReadProfiler" >
        <property name="name" value="clientReadProfiler" />
    </bean>

    <!--
        Profiles every GigaSpace data-operation call (read*, write*, take*, change*, count, clear,
        aggregate, iterator, execute, asyncLoad, ...). Accessors/getters (get*, is*, set*, new*) are
        excluded: they're config lookups, not API calls, and getName() is invoked by the advice
        itself (see ClientReadProfiler.profile), so including it would recurse infinitely.
    -->
    <aop:config>
        <aop:aspect ref="clientReadProfiler">

            <aop:pointcut id="clientReadProfilerPointcut"
                          expression="execution(* org.openspaces.core.GigaSpace.*(..))
                                       and !execution(* org.openspaces.core.GigaSpace.get*(..))
                                       and !execution(* org.openspaces.core.GigaSpace.is*(..))
                                       and !execution(* org.openspaces.core.GigaSpace.set*(..))
                                       and !execution(* org.openspaces.core.GigaSpace.new*(..))" />

            <aop:around pointcut-ref="clientReadProfilerPointcut"
                        method="profile" />

        </aop:aspect>
    </aop:config>

</beans>
